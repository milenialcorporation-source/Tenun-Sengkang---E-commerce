rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'azkarmsd@gmail.com'; }

    function isValidConfig(data) {
      return data.keys().hasAll(['heroSlides', 'collections', 'products', 'showOlsera', 'hamburgerProducts', 'hamburgerCollections'])
          && data.showOlsera is bool
          && data.heroSlides is list
          && data.collections is list
          && data.products is list
          && data.hamburgerProducts is list
          && data.hamburgerCollections is list;
    }

    match /config/main {
      allow read: if true;
      allow create: if isAdmin() && isValidConfig(incoming());
      allow update: if isAdmin() && isValidConfig(incoming());
      allow delete: if false;
    }
  }
}
