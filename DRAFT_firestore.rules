rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidConfig(data) {
      return data.keys().hasAll(['heroSlides', 'collections', 'products', 'showOlsera'])
          && data.showOlsera is bool
          && data.heroSlides is list
          && data.collections is list
          && data.products is list;
    }

    match /config/main {
      allow read: if true;
      allow create: if isSignedIn() && isValidConfig(incoming());
      allow update: if isSignedIn() && isValidConfig(incoming());
      allow delete: if false;
    }
  }
}
